{
    "name": "kusaasira/uganda-geo",
    "description": "Identity-safe Uganda administrative geography for PHP, with district-to-village lookups and optional GIS tooling",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-json": "*"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Joshua Kusaasira",
            "email": "joshuakusaasira@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Uganda\\Laravel\\": "integrations/laravel/",
            "Uganda\\": "src/Uganda/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Uganda\\Laravel\\UgandaGeoServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/yaml": "^7.4",
        "symplify/easy-coding-standard": "^13.2",
        "phpstan/phpstan": "^2.3"
    },
    "scripts": {
        "cs-test": "ecs check src tests",
        "cs-fix": "ecs check src tests --fix",
        "test": "phpunit"
    },
    "keywords": [
        "uganda",
        "geography",
        "administrative-areas",
        "districts",
        "counties",
        "subcounties",
        "parishes",
        "villages",
        "geospatial"
    ],
    "homepage": "https://github.com/kusaasira/uganda-geo-data",
    "support": {
        "issues": "https://github.com/kusaasira/uganda-geo-data/issues",
        "source": "https://github.com/kusaasira/uganda-geo-data",
        "docs": "https://github.com/kusaasira/uganda-geo-data/blob/main/README.md"
    },
    "suggest": {
        "ext-intl": "Optional ICU dependency for Unicode-aware exact, prefix and fuzzy administrative searches",
        "ext-pdo": "Required only when using optional database integration",
        "ext-pdo_sqlite": "Optional SQLite adapter for database synchronization",
        "ext-pdo_mysql": "Optional MySQL and MariaDB adapter for database synchronization",
        "ext-pdo_pgsql": "Optional PostgreSQL adapter for database synchronization"
    },
    "bin": [
        "bin/uganda-geo"
    ]
}
