{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uganda Geo Boundary Feature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "boundary_id",
    "source_id",
    "source_feature_id",
    "unit_id",
    "source_crs",
    "crs",
    "verification_status",
    "geometry",
    "properties"
  ],
  "properties": {
    "boundary_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_feature_id": {
      "type": "string",
      "minLength": 1
    },
    "unit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_crs": {
      "type": "string",
      "minLength": 1
    },
    "crs": {
      "type": "string",
      "const": "EPSG:4326"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unmatched",
        "provisional",
        "verified",
        "disputed"
      ]
    },
    "reference_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "properties": {
      "type": "object"
    }
  }
}
