{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kusaasira/uganda-geo-data/next/2.x/resources/schemas/canonical-snapshot.schema.json",
  "title": "Uganda Geo Canonical Dataset Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "source_ids",
    "units"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reference_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "administrative-unit.schema.json"
      }
    }
  }
}
